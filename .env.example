# ---- Rain (Raingentic hackathon sandbox — api-dev.raincards.xyz/v1) ----
# RAIN_MODE=mock runs the whole pipeline offline (default).
# RAIN_MODE=live hits the Rain sandbox using the workshop-desk credentials below.
RAIN_MODE=mock
RAIN_BASE_URL=https://api-dev.raincards.xyz/v1

# From the workshop desk (SANDBOX keys only — never a production key):
RAIN_API_KEY=          # Api-Key header, authenticates every request
RAIN_USER_ID=          # cardholder you issue cards to
RAIN_CONTRACT_ID=      # collateral contract you fund
RAIN_TEAM_ID=         # scopes list endpoints
RAIN_SESSION_ID=       # required header for card issuance (from the sandbox playground)

# ---- LLM (later, for selection agent) ----
ANTHROPIC_API_KEY=

# ---- Server ----
PORT=3000
